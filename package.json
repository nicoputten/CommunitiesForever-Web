{
  "name": "communitiesforever-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "design": "node scripts/serve-design.mjs",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "import:items": "node --import ./scripts/ts-hooks.mjs scripts/import-items.ts",
    "test:design": "vitest run tests/design && playwright test -c playwright.design.config.ts"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-hover-card": "1.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.22",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "minisearch": "7.2.0",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nuqs": "2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-zoom-pan-pinch": "4.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": false,
    "unrs-resolver": false,
    "better-sqlite3@13.0.3": true
  }
}
