# Example configuration. Copy to .env.local for development; real values go in the TrueNAS app config.

# Directory for the SQLite database (communitiesforever.sqlite). /data in the container. Locally keep it OUTSIDE the
# repo: `next dev` watches the project folder, so a database inside it rebuilds and reloads the page on every write.
DATA_DIR=../CommunitiesForever-Web-data

# Auth.js (WEB-06). A random secret that signs the session cookies, e.g. `openssl rand -base64 33`.
AUTH_SECRET=
# The site's public URL: http://localhost:3000 locally, https://wow.vestras.nl live.
AUTH_URL=http://localhost:3000
# Battle.net app from https://develop.battle.net (client id and secret). Redirect URL per site:
# <AUTH_URL>/api/auth/callback/battlenet
AUTH_BATTLENET_ID=
AUTH_BATTLENET_SECRET=
# The admin's BattleTag (Name#1234): may always sign in and upload, owns the admin page, can't be blocked.
# Quote it in .env files, e.g. ADMIN_BATTLETAG="Name#1234": unquoted, everything from the # on is read as a comment.
ADMIN_BATTLETAG=

# Discord linking (WEB-39): the Discord application's OAuth2 client id and secret (discord.com/developers). Its only
# redirect is <AUTH_URL>/api/discord/callback. Without both, "Link Discord" is off.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The uploader's release workflow publishes new versions with this (WEB-35), as a Bearer token: at least 32 random
# characters, e.g. `openssl rand -base64 33`; the same value is a GitHub secret in the uploader repo. Without it,
# publishing is off.
UPLOADER_DEPLOY_SECRET=

# Set by the Docker image (WEB-07), not by hand: DATA_DIR=/data, HOSTNAME=0.0.0.0, PORT=3000 and APP_VERSION (the
# release tag, shown by /api/health; "dev" outside the image).

# Tests only (WEB-30): pins the site's "now" to these Unix seconds so the design checks' screenshots don't change
# with the clock. Never set it on the live site.
# FIXED_NOW=
