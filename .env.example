# Example configuration. Copy to .env.local for development; real values go in the TrueNAS app config.

# Directory for the SQLite database (communitiesforever.sqlite). Default ./data; /data in the container.
DATA_DIR=./data

# Admin's BattleTag: the site name comes from the community of the admin's uploads (WEB-06 documents it in full).
# ADMIN_BATTLETAG=Nico#2201

# STUB until WEB-06 (Battle.net sign-in): the signed-in user as "BattleTag#1234:role" (admin, member or guest).
# Unset means signed out. Never set it on the live site.
# DEV_VIEWER=Nico#2201:admin
