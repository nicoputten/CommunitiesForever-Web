# Example configuration. Copy to .env.local for development; real values go in the TrueNAS app config.

# Directory for the SQLite database (communitiesforever.sqlite). Default ./data; /data in the container.
DATA_DIR=./data

# Auth.js (WEB-06). A random secret that signs the session cookies, e.g. `openssl rand -base64 33`.
AUTH_SECRET=
# The site's public URL: http://localhost:3000 locally, https://wow.vestras.nl live.
AUTH_URL=http://localhost:3000
# Battle.net app from https://develop.battle.net (client id and secret). Redirect URL per site:
# <AUTH_URL>/api/auth/callback/battlenet
AUTH_BATTLENET_ID=
AUTH_BATTLENET_SECRET=
# The admin's BattleTag (Name#1234): may always sign in and upload, owns the admin page, can't be blocked.
ADMIN_BATTLETAG=

# Set by the Docker image (WEB-07), not by hand: DATA_DIR=/data, HOSTNAME=0.0.0.0, PORT=3000 and APP_VERSION (the
# release tag, shown by /api/health; "dev" outside the image).

# Tests only (WEB-30): pins the site's "now" to these Unix seconds so the design checks' screenshots don't change
# with the clock. Never set it on the live site.
# FIXED_NOW=
